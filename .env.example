TELEGRAM_BOT_TOKEN=123456:ABC-DEF
# batas unggah Telegram Bot API gratis = 50 MB (20 MB untuk foto)
MAX_UPLOAD_MB=50
# direktori kerja sementara
WORK_DIR=/tmp/media-bot
# opsional: path cookie per platform
COOKIE_INSTAGRAM=cookies/instagram.txt
COOKIE_X=cookies/x.txt
COOKIE_FACEBOOK=cookies/facebook.txt
# jumlah unduhan konkuren
MAX_CONCURRENT=3